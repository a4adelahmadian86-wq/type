APP_NAME=FARAST
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=farast
DB_USERNAME=farast
DB_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# --- ایمیل ---
# گزینه‌ها: log | smtp | mailtrap | brevo | resend
MAIL_MAILER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=FARAST

# Resend (رایگان ~3000/ماه) — https://resend.com
RESEND_API_KEY=

# Brevo (رایگان ~300/روز) — https://www.brevo.com
BREVO_API_KEY=

# Mailtrap (تست) — https://mailtrap.io
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525

FILES_HOST_URL=
FILES_HOST_TOKEN=
FILES_API_KEY=
FILES_TTL_DAYS=14

FARAST_ADMIN_PHONE=
FARAST_ADMIN_PASSWORD=
FREE_PAGES_PER_WEEK=1
MAX_ACTIVE_EDITOR_SESSIONS=1
